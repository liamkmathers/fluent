# Personal learning data - DO NOT commit
/data/*.json
/data/*.json.backup-*
/results/*.md
# Except the README files which explain the structure
!/data/README.md
!/results/README.md

# Personal writing/practice files
myfile.txt

# Backup files created by hooks
.backups/

# Keep directory structure but ignore contents
!/data/.gitkeep
!/results/.gitkeep

# Large raw frequency corpora (regenerable — see curriculum/sources/README.md).
# The processed curriculum/*-frequency.json IS committed.
/curriculum/sources/*.txt

# System files
.DS_Store
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-*

# Python bytecode
__pycache__/
*.pyc

# Logs
*.log
npm-debug.log*

# Temp files
.tmp/
temp/
*.json.tmp


# Python virtualenv (project-local, do not commit)
.venv/

# Whisper model cache
.cache/
